---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, formatDate, readingTime } from '../../lib/posts';
export async function getStaticPaths() { return (await getPosts()).map(post => ({params: {id:post.id}, props: {post}})); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const related = (await getPosts()).filter(p => p.id !== post.id).slice(0,2);
---
<Base title={post.data.title} description={post.data.description} article={{date:post.data.date,tags:post.data.tags}} noindex={post.data.sample}>
  <article class="article-layout"><header class="article-heading"><a class="back-link" href="/posts/">← 모든 글</a><div class="post-labels"><a class="category-label" href={`/posts/?category=${encodeURIComponent(post.data.category)}`}>{post.data.category}</a>{post.data.sample && <span class="sample-label">예시 글</span>}</div><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p><div class="post-meta"><span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></span><span class="meta-divider"></span><span>{readingTime(post.body)}분 읽기</span><span class="meta-divider"></span><span>NyanPunch</span></div></header>
  <div class="article-grid"><div>{post.data.sample && <aside class="sample-notice">이 글은 블로그 구성을 보여주는 예시 글입니다.</aside>}<div class="prose"><Content/></div><div class="tag-list">{post.data.tags.map(tag => <span>#{tag}</span>)}</div><div class="article-bottom"><a class="text-link" href="/posts/">← 글 목록으로</a><button id="copy-link" class="text-link" type="button">링크 복사 <Icon name="external" size={16}/></button><span id="copy-status" role="status" class="copy-status"></span></div></div>
  <aside class="toc"><p class="eyebrow">ON THIS PAGE</p><nav aria-label="글 목차">{headings.filter(h=>h.depth<=3).map(h=><a class:list={[{indent:h.depth===3}]} href={`#${h.slug}`}>{h.text}</a>)}</nav></aside></div>
  {related.length > 0 && <section class="related-posts"><div class="section-heading"><h2>이런 기록도 있어요</h2></div><div class="related-grid">{related.map(p=><a href={`/posts/${p.id}/`}><span class="category-label">{p.data.category}</span><h3>{p.data.title}</h3><span class="text-link">읽어보기 →</span></a>)}</div></section>}</article>
  <script>document.querySelector('#copy-link')?.addEventListener('click', async () => { const status = document.querySelector('#copy-status'); try { await navigator.clipboard.writeText(location.href); if(status) status.textContent = '링크를 복사했어요.'; } catch { if(status) status.textContent = '주소창의 링크를 복사해 주세요.'; } });</script>
</Base>
